http://{$DOMAIN} {
    encode zstd gzip

    @xendit path /payment/xendit/*
    handle @xendit {
        reverse_proxy odoo:8069
    }

    @odoo_return path /dsayur/return
    handle @odoo_return {
        reverse_proxy odoo:8069
    }

    handle {
        reverse_proxy storefront:3000
    }
}

http://{$ODOO_DOMAIN} {
    encode zstd gzip

    # Odoo's evented worker handles browser WebSocket connections separately.
    handle /websocket* {
        reverse_proxy odoo:8072
    }

    handle {
        reverse_proxy odoo:8069
    }
}
