<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dsayur_store_branch_list" model="ir.ui.view">
        <field name="name">dsayur.store.branch.list</field>
        <field name="model">dsayur.store.branch</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="address"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="dsayur_store_branch_form" model="ir.ui.view">
        <field name="name">dsayur.store.branch.form</field>
        <field name="model">dsayur.store.branch</field>
        <field name="arch" type="xml">
            <form string="Cabang D-Sayur">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="address"/>
                            <field name="active"/>
                        </group>
                        <group string="Koordinat peta">
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="dsayur_store_branch_action" model="ir.actions.act_window">
        <field name="name">Cabang D-Sayur</field>
        <field name="res_model">dsayur.store.branch</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="dsayur_store_branch_menu" name="Cabang Toko" parent="dsayur_operations_root" action="dsayur_store_branch_action" sequence="5" groups="sales_team.group_sale_manager"/>
</odoo>
