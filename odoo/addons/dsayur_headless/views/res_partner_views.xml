<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dsayur_res_partner_address_label_form" model="ir.ui.view">
        <field name="name">res.partner.form.dsayur.address.label</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='street']" position="after">
                <field name="dsayur_address_label" string="Simpan sebagai"
                       placeholder="Alamat 1, Alamat 2"
                       invisible="type not in ('delivery', 'other')"/>
            </xpath>
        </field>
    </record>
</odoo>
