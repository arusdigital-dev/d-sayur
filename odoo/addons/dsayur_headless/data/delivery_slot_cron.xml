<odoo>
    <record id="dsayur_delivery_slot_generation_cron" model="ir.cron">
        <field name="name">D-Sayur: Generate upcoming delivery slots</field>
        <field name="model_id" ref="model_dsayur_delivery_slot"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_upcoming_slots()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
