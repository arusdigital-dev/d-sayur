<odoo>
    <record id="xendit_serialization_retry_cron" model="ir.cron">
        <field name="name">D-Sayur: Retry transient Xendit callbacks</field>
        <field name="model_id" ref="payment.model_payment_data"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry_xendit_serialization_failures()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
